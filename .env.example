# Copie este arquivo para ".env" e preencha com seus valores reais.

# Django
SECRET_KEY=troque-por-uma-chave-aleatoria-grande
DEBUG=True
ALLOWED_HOSTS=*

# URL pública do site (usada nos retornos e webhook do Mercado Pago)
SITE_URL=http://localhost:7100

# Mercado Pago — quando tiver suas credenciais, preencha aqui e o site
# passa a cobrar de verdade (Checkout Pro). Enquanto vazio, modo simulado.
# Pegue em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# E-mail — sem preencher, os e-mails aparecem no console do servidor (modo teste).
# Para enviar de verdade, descomente e configure um SMTP. Exemplo com Gmail
# (precisa criar uma "senha de app" em myaccount.google.com/apppasswords):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=seuemail@gmail.com
# EMAIL_HOST_PASSWORD=senha-de-app-aqui
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Ingressou <seuemail@gmail.com>
